# Application
APP_NAME=neuro-hub
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# MCP Server
MCP_SERVER_NAME=neuro-hub-memory
MCP_SERVER_VERSION=1.0.0

# Vector Database (Milvus)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=neuro_hub
MILVUS_COLLECTION_PREFIX=nh_

# Graph Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL=3600
REDIS_MAX_CONNECTIONS=50

# Relational Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=neuro_hub
POSTGRES_PASSWORD=password
POSTGRES_DB=neuro_hub

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_SIZE=10000

# Multi-Modal Embeddings (optional)
VOYAGE_API_KEY=
AMAZON_NOVA_API_KEY=

# Search & Retrieval
HYBRID_SEARCH_ALPHA=0.5
BM25_K1=1.5
BM25_B=0.75
RERANK_MODEL=
RERANK_TOP_K=100
RERANK_FINAL_K=10

# Memory Consolidation
CONSOLIDATION_ENABLED=true
CONSOLIDATION_BATCH_SIZE=100
CONSOLIDATION_INTERVAL_SECONDS=300
ENTITY_RESOLUTION_THRESHOLD=0.85
DEDUPLICATION_THRESHOLD=0.90

# Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
OAUTH2_ENABLED=false

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# Observability
OTEL_ENABLED=true
OTEL_SERVICE_NAME=neuro-hub
OTEL_EXPORTER_JAEGER_ENDPOINT=http://localhost:14268/api/traces
PROMETHEUS_PORT=9090

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
